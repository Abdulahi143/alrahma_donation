# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (Resend; verified sender address)
RESEND_API_KEY=
BROADCAST_FROM_EMAIL=
# WhatsApp (keep false until Meta setup is complete)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
